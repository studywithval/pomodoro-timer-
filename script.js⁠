const CIRC = 603.2;

const CATS = {
  focus: 'https://media.giphy.com/media/v1.Y2lkPTc5MGI3NjExM3ZhcXFidmxxb3g1Y3A1M3R5N3dwbnU1bXg5YWRhNml4Mmptb3pkeCZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9cw/8g75nUdA6wNf79H6K4/giphy.gif',
  short: 'https://media.giphy.com/media/MDJ9IbxxvDUQM/giphy.gif',
  long:  'https://media.giphy.com/media/MDJ9IbxxvDUQM/giphy.gif',
};

// ── State ──
let total     = 25 * 60;
let remaining = 25 * 60;
let running   = false;
let interval  = null;
let sessions  = 0;
let modeKey   = 'focus';
let tasks     = [];

// ── Elements ──
const disp      = document.getElementById('disp');
const arc       = document.getElementById('arc');
const startBtn  = document.getElementById('startbtn');
const phaseLbl  = document.getElementById('phase-lbl');
const catImg    = document.getElementById('catimg');
const toastEl   = document.getElementById('toast');
const dotsEl    = document.getElementById('dots');
const taskIn    = document.getElementById('task-in');
const taskList  = document.getElementById('task-list');
const addBtn    = document.getElementById('add-btn');

// ── Helpers ──
function fmt(secs) {
  const m = Math.floor(secs / 60);
  const s = secs % 60;
  return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
}

function updateArc() {
  arc.style.strokeDashoffset = CIRC * (1 - remaining / total);
}

function showToast(msg, color = '#D4537E') {
  toastEl.textContent = msg;
  toastEl.style.background = color;
  toastEl.classList.add('show');
  setTimeout(() => toastEl.classList.remove('show'), 1800);
}

// ── Dots ──
function renderDots() {
  dotsEl.innerHTML = '';
  for (let i = 0; i < 4; i++) {
    const dot = document.createElement('div');
    dot.className = 'dot' + (i < sessions ? ' done' : '');
    dotsEl.appendChild(dot);
  }
}

// ── Mode ──
function setMode(key, mins, label) {
  clearInterval(interval);
  running = false;
  startBtn.textContent = 'start';

  modeKey   = key;
  total     = mins * 60;
  remaining = total;

  disp.textContent       = fmt(remaining);
  arc.style.strokeDashoffset = 0;
  phaseLbl.textContent   = label;
  catImg.src             = CATS[key] || CATS.focus;

  document.querySelectorAll('.mtab').forEach(t => t.classList.remove('active'));
  document.getElementById('tab-' + key).classList.add('active');
}

// ── Timer controls ──
function toggle() {
  if (!running) {
    running = true;
    startBtn.textContent = 'pause';

    interval = setInterval(() => {
      remaining--;
      disp.textContent = fmt(remaining);
      updateArc();

      if (remaining <= 0) {
        clearInterval(interval);
        running = false;
        startBtn.textContent = 'start';

        if (modeKey === 'focus') {
          sessions = Math.min(4, sessions + 1);
          renderDots();
          showToast(sessions === 4 ? '4 done! take a long break 🎉' : 'session done! great work', '#D4537E');
          if (sessions === 4) sessions = 0;
        } else {
          showToast('break over! back to it', '#534AB7');
        }
      }
    }, 1000);

  } else {
    running = false;
    startBtn.textContent = 'resume';
    clearInterval(interval);
  }
}

function reset() {
  clearInterval(interval);
  running = false;
  startBtn.textContent = 'start';
  remaining = total;
  disp.textContent = fmt(remaining);
  arc.style.strokeDashoffset = 0;
}

function skip() {
  if (modeKey === 'focus') {
    sessions = Math.min(4, sessions + 1);
    renderDots();
  }
  reset();
  showToast('skipped!', '#1D9E75');
}

// ── Tasks ──
function addTask() {
  const val = taskIn.value.trim();
  if (!val) return;
  tasks.push({ text: val, done: false });
  taskIn.value = '';
  renderTasks();
}

function toggleTask(i) {
  tasks[i].done = !tasks[i].done;
  renderTasks();
}

function renderTasks() {
  taskList.innerHTML = '';
  tasks.forEach((t, i) => {
    const item = document.createElement('div');
    item.className = 'task-item' + (t.done ? ' done-task' : '');
    
    // Toggle done status only when clicking the task content area
    item.onclick = (e) => {
      if (e.target.classList.contains('del-btn')) return;
      toggleTask(i);
    };

    const check = document.createElement('div');
    check.className = 'check';
    if (t.done) check.innerHTML = `<svg width="11" height="11" viewBox="0 0 11 11"><polyline points="1.5,5.5 4.5,8.5 9.5,2.5" stroke="white" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
    
    const label = document.createElement('span');
    label.textContent = t.text;
    label.style.flex = "1"; // Pushes delete button to the right

    const delBtn = document.createElement('button');
    delBtn.className = 'del-btn';
    delBtn.textContent = '×';
    delBtn.style.cssText = "background:none; border:none; color:#c8aab7; font-size:18px; cursor:pointer; padding:0 4px;";
    delBtn.onclick = (e) => {
      e.stopPropagation(); // Prevent triggering toggleTask
      tasks.splice(i, 1);
      renderTasks();
    };

    item.appendChild(check); 
    item.appendChild(label); 
    item.appendChild(delBtn);
    taskList.appendChild(item);
  });
}
