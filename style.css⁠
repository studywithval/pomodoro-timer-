@import url('https://fonts.googleapis.com/css2?family=Fredoka+One&display=swap');

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff9fb;
  font-family: 'Fredoka One', cursive;
}

/* â”€â”€ Layout â”€â”€ */
.wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  padding: 2rem 1.5rem 2.5rem;
  width: 100%;
  max-width: 400px;
}

/* â”€â”€ Mode tabs â”€â”€ */
.mode-row {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  justify-content: center;
}

.mtab {
  font-family: 'Fredoka One', cursive;
  font-size: 14px;
  padding: 6px 16px;
  border-radius: 20px;
  border: 2px solid transparent;
  cursor: pointer;
  transition: all 0.15s;
  background: #f5f0f3;
  color: #888;
}

.mtab:hover {
  background: #FBEAF0;
  color: #993556;
}

.mtab.active {
  color: #993556;
  background: #FBEAF0;
  border-color: #ED93B1;
}

/* â”€â”€ Ring â”€â”€ */
.ring-area {
  position: relative;
  width: 220px;
  height: 220px;
}

.ring-area svg {
  position: absolute;
  top: 0;
  left: 0;
}

#arc {
  transition: stroke-dashoffset 0.95s linear;
}

.ring-center {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
}

.cat-gif {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  border: 3px solid #ED93B1;
  object-fit: cover;
}

.time-txt {
  font-family: 'Fredoka One', cursive;
  font-size: 52px;
  line-height: 1;
  color: #2c2c2a;
  letter-spacing: 1px;
}

/* â”€â”€ Toast â”€â”€ */
.toast {
  position: absolute;
  top: -44px;
  left: 50%;
  transform: translateX(-50%);
  font-family: 'Fredoka One', cursive;
  font-size: 14px;
  padding: 6px 18px;
  border-radius: 20px;
  white-space: nowrap;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s;
  color: #fff;
}

.toast.show {
  opacity: 1;
}

/* â”€â”€ Phase badge â”€â”€ */
.phase-badge {
  font-family: 'Fredoka One', cursive;
  font-size: 14px;
  padding: 4px 14px;
  border-radius: 20px;
  background: #EEEDFE;
  color: #534AB7;
  border: 1.5px solid #AFA9EC;
  letter-spacing: 0.3px;
}

/* â”€â”€ Buttons â”€â”€ */
.btn-row {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  justify-content: center;
}

.bigbtn {
  font-family: 'Fredoka One', cursive;
  font-size: 18px;
  padding: 12px 28px;
  border-radius: 24px;
  border: 2px solid;
  cursor: pointer;
  transition: all 0.12s;
  letter-spacing: 0.5px;
}

.bigbtn:active {
  transform: scale(0.96);
}

.start-btn {
  background: #D4537E;
  border-color: #993556;
  color: #fff;
}

.start-btn:hover {
  background: #993556;
}

.reset-btn {
  background: #EEEDFE;
  border-color: #AFA9EC;
  color: #3C3489;
}

.reset-btn:hover {
  background: #CECBF6;
}

.skip-btn {
  background: #E1F5EE;
  border-color: #5DCAA5;
  color: #085041;
}

.skip-btn:hover {
  background: #9FE1CB;
}

/* â”€â”€ Session dots â”€â”€ */
.dots-row {
  display: flex;
  gap: 10px;
  align-items: center;
}

.dot {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: #f5f0f3;
  border: 2px solid #ED93B1;
  transition: all 0.3s;
}

.dot.done {
  background: #D4537E;
  border-color: #993556;
}

/* â”€â”€ Task input â”€â”€ */
.task-row {
  display: flex;
  gap: 8px;
  width: 100%;
}

.task-row input {
  flex: 1;
  font-family: 'Fredoka One', cursive;
  font-size: 14px;
  padding: 9px 14px;
  border-radius: 16px;
  border: 2px solid #ED93B1;
  background: #fff;
  color: #2c2c2a;
  outline: none;
  transition: border-color 0.15s;
}

.task-row input:focus {
  border-color: #D4537E;
}

.task-row input::placeholder {
  color: #c8aab7;
}

.task-row button {
  font-family: 'Fredoka One', cursive;
  font-size: 14px;
  padding: 9px 16px;
  border-radius: 16px;
  border: 2px solid #5DCAA5;
  background: #E1F5EE;
  color: #085041;
  cursor: pointer;
  transition: background 0.12s;
}

.task-row button:hover {
  background: #9FE1CB;
}

/* â”€â”€ Task list â”€â”€ */
.task-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.task-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 14px;
  border-radius: 14px;
  border: 1.5px solid #ede0e8;
  background: #fff;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.15s;
  color: #2c2c2a;
}

.task-item:hover {
  border-color: #ED93B1;
  background: #fff9fb;
}

.task-item.done-task {
  opacity: 0.45;
  text-decoration: line-through;
}

.check {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  border: 2px solid #ED93B1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s;
}

.task-item.done-task .check {
  background: #D4537E;
  border-color: #993556;
}

/* â”€â”€ Responsive â”€â”€ */
@media (max-width: 440px) {
  .wrap {
    padding: 1.5rem 1rem 2rem;
  }

  .bigbtn {
    font-size: 16px;
    padding: 10px 20px;
  }

  .time-txt {
    font-size: 44px;
  }
}
